<?xml version="1.0" encoding="UTF-8"?>
<!--
  xiaozhujue-api —— 小主角的账号与权限后端

  ★ 这个模块只管两件事：**你是谁**（登录、短信核验、改昵称、换默认头像）与
    **你能用什么**（四个能力开关）。它**不接任何模型厂商**，也不碰作品文件——
    生成与作品都在 Next 那一侧（见 README §二 的分工）。

  ★ 版本不是随手挑的：本机 Maven 仓库里已经有这些坐标（1.5 GB，课程项目留下的），
    所以第一次 `mvn package` 不必把整个 Spring 世界重新下一遍。
    Boot 3.3.5 与 mybatis-plus-spring-boot3-starter 3.5.7 都是这一档里配套的。
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <groupId>com.onceuponme</groupId>
  <artifactId>xiaozhujue-api</artifactId>
  <version>0.1.0</version>
  <name>xiaozhujue-api</name>
  <description>小主角 · 账号与权限后端</description>

  <properties>
    <!-- ★ 17 不是"顺手写的老版本"：服务器装的是 openjdk-17-jre-headless，
         本机 Maven 用的也是 JDK 17.0.18（java -version 是 24，Maven toolchain 是 17）。
         三处（本机编译、本机跑、服务器跑）必须是同一档 -->
    <java.version>17</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- 本机仓库里已有的版本（见文件头）。不引 Lombok：DTO 用 record，
             少一个注解处理器，也少一处"编译器插件版本没跟上"的坑 -->
    <mybatis-plus.version>3.5.7</mybatis-plus.version>
    <jjwt.version>0.12.6</jjwt.version>
    <aliyun-dypns.version>2.0.0</aliyun-dypns.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ★ 只要 spring-security-crypto（BCrypt 一个人），**不要** starter-security：
         引了它，默认那条过滤器链会把所有接口一起拦掉，而我们的鉴权是自己写的
         （一张 JWT + 一个 BFF 共享的内部令牌），不需要第二条真相 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>

    <!-- 生产用的数据库驱动。runtime：代码里不出现它 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- ★ 本地开发与测试用的库（local profile）。它**会**跟着打进 jar：
         本地要把整条链路（BFF → Java → 库）真跑起来，就得有个库。
         生产 profile 一个字段都不指向它，这一点写在 application.yml 的注释里 -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- 阿里云号码认证（短信认证）——**文档里那条路**，也是实测唯一走得通的那条。
         ★ 2026-10-16 量出来的事实（探针在 `.out/aliyun-probe/`，未进仓库）：
         · 短信服务（`dysmsapi`）那边，这个账号 `QuerySmsSignList` 回 `totalCount=0`
           —— **一条签名都没有**，于是 `SendSms` 一律回 `isv.SMS_SIGNATURE_ILLEGAL`；
         · 号码认证（`dypnsapi`）用文档里那对值（签名 `恒创联众` / 模板 `100001`）
           回 `code=OK success=true`，短信真的发到了手机上。
         所以原来把它换掉的那次判断是**错的**（我当时只看到一张短信服务的模板截图，
         没去查签名列表），现在换回来。
         ★ 用法上有一处刻意与文档不同：模板参数传**具体的码**而不是 `##code##`
           （文档说这种情况"阿里云接口无法校验"）—— 核验因此在我们这边
           （`SmsCodeStore`），换来的是**一个码最多试 5 次**。 -->
    <dependency>
      <groupId>com.aliyun</groupId>
      <artifactId>dypnsapi20170525</artifactId>
      <version>${aliyun-dypns.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <!-- 产物名固定，部署脚本（server/deploy.sh）与 systemd unit 都按它找 -->
        <configuration>
          <finalName>xiaozhujue-api</finalName>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
