{
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-credits/types/**/*.ts",
    ".next-judge/types/**/*.ts",
    ".next-redeem/types/**/*.ts",
    ".next-session/types/**/*.ts",
    ".next-share/types/**/*.ts",
    ".next-sharecheck/types/**/*.ts",
    ".next-shots/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-insp/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
