# ============================================================================
# 环境变量模板
#
# 用法：
#   cp .env.example .env.local      # 然后填入真实值
#
# ★ 本文件随仓库公开，禁止写入任何真实密钥
# ★ 所有变量都只在服务端使用（Next.js 的 API Routes / Server Actions），
#   所以一律不加 NEXT_PUBLIC_ 前缀 —— 加了就会被打进客户端 bundle 泄露出去。
# ★ 变量按「能力」而非「厂商」命名：换模型供应商时只改值，不改代码。
#
# 当前状态：AI 能力尚未接入，以下是给后续 lib/engine/ 预留的位置，
# 现在填了不会有任何作用。见 README「已知取舍」。
# ============================================================================

# ── 大模型：故事分镜规划 / 故事树 / 一致性校验 / 安全审核
LLM_API_KEY=
LLM_BASE_URL=

# ── 图像生成：角色卡候选图 + 逐页插画
IMAGE_API_KEY=
IMAGE_BASE_URL=

# ── 语音合成：父母声音克隆 + 逐页配音
TTS_API_KEY=
TTS_BASE_URL=
