# ============================================================================
# 环境变量模板
#
# 用法：
#   cp .env.example .env.local      # 然后填入真实值
#
# ★ 本文件随仓库公开，禁止写入任何真实密钥
# ★ 所有变量都只在服务端使用（Route Handler / node 脚本），所以一律不加
#   NEXT_PUBLIC_ 前缀 —— 加了就会被打进客户端 bundle 泄露出去。
#   供应商自己也明确禁止把 Key 写进"公开代码、浏览器脚本或日志"。
# ★ 变量按「能力」而非「厂商」命名：换模型供应商时只改值，不改代码。
#
# ★★ 模型名一律写在这里，**代码里不写死**。
#    2026 年这个领域版本号季度级变化，把模型 id 写进引擎等于
#    "换一次模型 = 改代码 + 重过三条闸门"。读法见 src/lib/engine/providers/registry.ts。
# ============================================================================

# ── 大模型：故事分镜规划 / 故事树 / 一致性校验 / 安全审核 ──────────────────
LLM_API_KEY=
# 带不带 /v1 都行，registry 会补齐
LLM_BASE_URL=https://tokenrhythm.studio/v1
# 必填。当前供应商的对话模型清单用 `GET /v1/models` 查（注意：该接口**不含**图像/视频模型）
LLM_MODEL=
# JSON 约束档：none | object | schema。横评要按档分别测，档位是判据的一部分
#
# ★ 与 Function Calling 能不能同给：**能**（2026-10-19 实测，scripts/probe-tool-calls.mts）。
#   同一个请求体同时带 tools 与 response_format，json_object 与 json_schema 两档都回 200，
#   而且模型真的回了 message.tool_calls。所以「工具那一档」不必放弃这一行。
LLM_JSON_MODE=object
LLM_TIMEOUT_MS=
# 单次生成一张故事表的 token 预算。留空 = 4096
# ★ 思考模型必须把它提上去，否则它会**把整个预算花在思考链上，正文一个字不写**。
#   实测（scripts/probe-thinking-budget.mts，同一 prompt 只改参数，2026-10-13）：
#     预算 4096  → qwen3.8-max 正文 0 字符 / 思考 9072 字符 / finish_reason=length
#                   qwen3.8-flash 正文 0 / 思考 9407 / length
#                   glm-5.3-flash 正文键都不存在 / 思考 10552 / length
#     预算 16000 → qwen3.8-flash 正文 1138 / 思考 11507 / stop（completion 5373 tokens）
#                   glm-5.3-flash 正文 1832 / 思考 15608 / stop（completion 7417 tokens）
#                   qwen3.8-max 这一档返回 504（网关等不及，不是参数被拒）
LLM_MAX_TOKENS=
# on | off。留空 = **off**（关思考），与平台默认值**相反**，这是实测决定的：
# 开着的默认配置在上述 4096 预算下就是坏的。想开思考请同时把预算提到 16000。
# 关思考后同一批模型 555–847 tokens 就写完一张表，比开思考便宜 5–7 倍；
# 代价是"思考带来的故事质量"未经测量——那是判据 2（语感）的事，见 §9.1
# ★ 例外：glm-5.3-flash **不允许**关思考，送 false 回
#   HTTP 400 · REASONING_REQUIRED · 当前模型必须开启深度思考；
#   而它开着思考又必须配 LLM_MAX_TOKENS=16000。选到这一家只能 on + 16000
LLM_THINKING=off

# ── 图像生成：角色卡参考图 + 逐页插画 ─────────────────────────────────────
IMAGE_API_KEY=
IMAGE_BASE_URL=https://tokenrhythm.studio/v1
# 候选：wan2.7-image / qwen-image-2.0（实测两个都能出图，一口价 0.20 元/张，与尺寸无关）
IMAGE_MODEL=wan2.7-image
# 一次出图实测在十几秒量级；同步接口**超时不要重试**（可能已扣费）
IMAGE_TIMEOUT_MS=180000
IMAGE_UNIT_COST_CNY=0.2
# ★ 参考图（锁脸）能力：**在这条图像接口上实测为"没有"**（2026-10-13）。
#   7 个候选字段名（image / image_url / reference_image / reference_images /
#   images / input_image / content[]）在 wan2.7-image 与 qwen-image-2.0 上
#   全部被同一个错误挡回：HTTP 400 · 请求包含未知字段。
#   所以跨页一致性**只能靠 prompt 里的角色锚点段**。
#   这个开关只在换供应商时才动：填 1 而供应商仍不支持，适配器会直接报错，
#   不会把参考图悄悄丢掉（丢掉的参考图比报错贵得多）。
#   探针脚本：scripts/probe-image-reference.mts（未知字段必拒，所以探字段名不扣费）
#   ★ 未核实：平台是否另有图生图 / 图像编辑接口。这里说的只是这一个接口没有。
IMAGE_SUPPORTS_REFERENCE=0

# ── 视觉比对：一致性 Agent 的手（缺省复用 LLM 的 key 与 base） ─────────────
VISION_API_KEY=
VISION_BASE_URL=
# 必须是一个**能吃图片输入**的模型；没有就整段留空，引擎会走"未核对"路径而不是瞎猜
VISION_MODEL=
# 留空 = 300s。这个调用一次送**两张 1440×1440 的图**（约 7 MB base64），
# 90s 实测不够：live 跑书时 kimi-k2.6 做比对，多页直接回 504 或 fetch failed。
# 超时的代价是"这一页没核对"，会让 r_redraw 算不出来。
# ★ 真正想快，得先把图缩到 768 再送——那要先有图像处理库（仓库现在没有，见 §7 待办）
VISION_TIMEOUT_MS=

# ── 检索用的嵌入：**2026-10-19 实测，这条接口上要不到** ────────────────────
# ★ 结论：`POST /v1/embeddings` **路由存在**，但这把 key 上**没有一个可用的嵌入模型**。
#   所以 `src/lib/rag/` 的检索只有**词法档**（中文字符 bigram + BM25），没有混合档，
#   这里也就**没有 EMBEDDING_* 这一组变量** —— 不写一个用不上的配置项。
#
#   实测（`node scripts/probe-embeddings.mts`，可重跑，约 30 次调用）：
#     · 对照组：**不存在的路径** → 404 · NOT_FOUND · 接口不存在
#     · 判别实验：确定存在的对话模型 qwen3.8-flash 打 /embeddings
#       → 400 · MODEL_CAPABILITY_NOT_SUPPORTED · 当前模型不支持该能力：embeddings
#       ★ 两者**不同形** ⇒ 路由是活的，上面那条是**模型级**拒绝，不是「没有这个入口」
#     · 目录里 26 个已服务模型逐个打：**0 个 200**；
#       25 个 CAPABILITY_NOT_SUPPORTED、1 个 ACCESS_DENIED（neohorse-1-9b，**没开通**）
#   ★ `neohorse-1-9b` 那一格**是空的不是否定的**：没开通就问不出它的能力。
#     去控制台看一眼它是不是嵌入模型 —— 是的话开通之后混合档就有了。
#
# ★ 换档条件：控制台开通一个嵌入模型，或换一家有嵌入接口的供应商。
#   那一天要做的四件事：回填 `.scratch/rag/spec.md` §二.4、加 EMBEDDING_* 这一组、
#   写 `providers/embeddings.ts`、把两档都实测一遍。
#   **在那之前别照着印象写适配器** —— `/v1/models` 的目录漏报过能力（tech-selection §1.2 已证）。

# ── 语音合成：父母声音克隆 + 逐页配音（W4 落地，现在填了不起作用） ─────────
# ★ 硬约束：候选供应商必须支持「上传样本 → 返回 voice_id → 可解绑/删除」，
#   否则与隐私设计的删除承诺冲突（docs/tech-selection.md §8.3）
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=

# ── 账号服务（Java 那一半）：Next 怎么找到它 ───────────────────────────────
# ★ 这一组是 2026-10-16 加后端之后才有的。前端**不直连** Java：
#   浏览器只打同源的 /api/*，由 Route Handler 转发（见 README §二「后端（Java）」）。
# 后端地址。本地就是本机那个 mvn spring-boot:run（缺省也是它）
BACKEND_URL=http://127.0.0.1:8080
# ★ BFF 与 Java 之间的共享令牌，Java 那边叫 APP_INTERNAL_TOKEN。
#   两边必须**逐字相同**，否则每个请求都是 403（实测过）。
#   ★ 它**不是**防线（公网是明文 HTTP），真正挡住陌生人的是"Java 只听回环"。
#   ★ 本地这份只设了 Next 那一个名字（`INTERNAL_TOKEN`），于是本地 Java 那一侧
#   **没有**令牌 → 那道检查在本地是关着的（启动日志里有一句 warn 说这件事）。
#   回环保护还在，功能不受影响；要本地也开着，就把同一个值写成两份
#   （`INTERNAL_TOKEN=` 与 `APP_INTERNAL_TOKEN=`，见下面那段 Java 侧的名字）。
INTERNAL_TOKEN=
# 会话票的签名密钥（HS256）。★ 与 Java 那把 `APP_JWT_SECRET` 必须**逐字相同**：
#   浏览器拿到的票由 Java 签，而 Next 在自己这一侧验签——两把不一样时的症状是
#   "登录返回 200，之后每个请求 401"，最容易被当成鉴权写错了。
APP_JWT_SECRET=

# ── 本站自己的运行时配置 ──────────────────────────────────────────────────
# 作品字节放哪儿。缺省 .out/web（开发机）／服务器上是 /var/lib/xiaozhujue/assets
ASSET_ROOT=
# 管理页"换模型"写出来的那份覆盖文件。缺省是仓库根下的 models.runtime.json。
# ★ 生产上把它挪出仓库目录（那个目录是部署产物，重新部署会擦掉）：
#   MODEL_CONFIG_FILE=/etc/xiaozhujue/models.json
MODEL_CONFIG_FILE=

# ── 语音：选哪一个音色做默认 ──────────────────────────────────────────────
# 用户自己挑的那个音色存在账号上（voices 表）；这个值只是"还没有人选过"时的兜底
TTS_VOICE=

# ============================================================================
# ★★ 不在这个文件里的那些钥匙：**后端（Java）那一半**的配置不读环境变量，
#    它读服务器上的 /etc/xiaozhujue/api.yml（640 root:xzj，由 systemd 挂进来）。
#    那一份里有：MySQL 的账号与口令、APP_JWT_SECRET 与 APP_INTERNAL_TOKEN、
#    管理员登录名与口令、以及短信那四项
#    （APP_SMS_ACCESS_KEY_ID / _SECRET / SIGN_NAME / TEMPLATE_CODE）。
#    见 docs/known-tradeoffs.md「先 IP + HTTP」那一节与 .scratch/backend-auth/issues/03。
#    本文件里**一个真实值都不能有**（仓库是公开的）。
# ★★ 但**本地**跑 Java 时它不是从 api.yml 读的，是从进程环境读的（`mvn spring-boot:run`
#    前先 `set -a; . ./.env.local; set +a`）。所以本地要把同一个值写成两份：
#    `INTERNAL_TOKEN`（Next 读）与 `APP_INTERNAL_TOKEN`（Java 读）——
#    只写前者时 Java 那侧的那道检查是**关**的（它只在有令牌时才校验）。
# ============================================================================

# ── 本机要不要**真发短信**（2026-10-19）────────────────────────────────────
# 默认假发：码固定 123456，接口如实回报 `devMode:true`（`DevSmsCodeSender`）。
# 要真发就把下面三行填上、并保持 `APP_SMS_ENABLED=true`——本机那一档的开关
# 就是读它（`server/src/main/resources/application-local.yml`）。
# ★ 签名与模板用号码认证服务里那对**赠送值**（恒创联众 / 100001），
#   就是 `application.yml` 里的默认值，一般不必写；换了账号才写这两行。
# ★ 真发是**计费**的，而且会真的发到那个号上——别拿它当"点一下看看"。
# ★ 开关与钥匙缺一不可：`StartupChecks` 在 enabled=true 而钥匙缺的时候直接抛异常
#   （服务起不来，不是降级成假发）。这一条与服务器上那份 api.yml 是同一个规矩。
APP_SMS_ENABLED=false
APP_SMS_ACCESS_KEY_ID=
APP_SMS_ACCESS_KEY_SECRET=

# ── 本地 H2 库放在哪儿（2026-10-18）────────────────────────────────────────
# `application-local.yml` 的 `APP_H2_PATH`。它**不设的时候是相对路径**
# （`./.local-db/xiaozhujue`），于是"用哪个库"由**进程的工作目录**决定——
# 2026-10-17 就是这样从仓库根起动了一次，H2 在根上新建了一个**空库**，
# 而里面没有管理员账号：症状是「口令昨天还好使，今天登不进去」。
# `server/run-local.cmd` 会把它钉成绝对路径（按脚本自己所在目录算），
# 所以走那个入口起动永远落在 `server/.local-db/xiaozhujue` 上；
# 手工起动时请从 `server/` 起，或者在这里写一条绝对路径。
